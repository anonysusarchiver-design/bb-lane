@@ -1083,6 +1083,29 @@ ipc::IPCResult DocAccessibleParent::AddChildDoc(DocAccessibleParent* aChildDoc,
     return IPC_FAIL(this, "Binding to parent that isn't a valid OuterDoc!");
   }
 
+  // S3V2 FIX-PROBE BEGIN (guard under test; remove before filing upstream).
+  // Mirrors the missing target-identity check: a child doc that was unbound
+  // from its embedder must only be re-bound under that same OuterDoc, so a
+  // forged re-bind under a different OuterDoc is rejected before any state
+  // mutation at the replace-old/bind block. This closes Arm 1 (wrong-O; the
+  // S3-style detached-target check alone cannot catch it because the forged
+  // target is attached) and Arm 2 (stale-child re-bind). mLastEmbedderID is
+  // recorded in Unbind() while the doc still knows its embedder. The
+  // S3-style detached-target check is kept below as a secondary defence
+  // with its own marker.
+  if (aChildDoc->mLastEmbedderID && aChildDoc->mLastEmbedderID != aParentID) {
+    printf_stderr(
+        "S3V2PROBE fix rejected wrong-embedder bind child=%" PRIu64
+        " last-embedder=%" PRIu64 " target=%" PRIu64 "\n",
+        aChildDoc->mActorID, aChildDoc->mLastEmbedderID, aParentID);
+    return IPC_FAIL(this, "binding to wrong embedder");
+  }
+  if (!outerDoc->RemoteParent() && !outerDoc->IsDoc()) {
+    printf_stderr("S3V2PROBE fix rejected detached embedder\n");
+    return IPC_FAIL(this, "binding to detached embedder");
+  }
+  // S3V2 FIX-PROBE END.
+
   if (outerDoc->ChildCount() == 1) {
     MOZ_ASSERT(outerDoc->RemoteChildAt(0)->AsDoc());
     outerDoc->RemoteChildAt(0)->AsDoc()->Unbind();
