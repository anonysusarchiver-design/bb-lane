diff --git a/accessible/ipc/DocAccessibleParent.cpp b/accessible/ipc/DocAccessibleParent.cpp
index 2ae68a9..fc4a6c3 100644
--- a/accessible/ipc/DocAccessibleParent.cpp
+++ b/accessible/ipc/DocAccessibleParent.cpp
@@ -13,6 +13,7 @@
 #include "mozilla/Components.h"  // for mozilla::components
 #include "mozilla/PerfStats.h"
 #include "mozilla/ProfilerMarkers.h"
+#include "mozilla/Printf.h"
 #include "mozilla/StaticPrefs_accessibility.h"
 #include "mozilla/a11y/PdfStructTreeBuilder.h"
 #include "mozilla/a11y/Platform.h"
@@ -1091,6 +1092,53 @@ ipc::IPCResult DocAccessibleParent::AddChildDoc(DocAccessibleParent* aChildDoc,
   outerDoc->SetChildDoc(aChildDoc);
   mChildDocs.AppendElement(aChildDoc->mActorID);
 
+  // S3PROBE BEGIN (test-only parent-side instrumentation; remove before
+  // filing upstream). Emits a grep-able state line for every child document
+  // bind. On the crafted bind (embedder is a detached outer doc), zombie=1
+  // and rootwalk-reaches-child=0 show a bound-but-unreachable document
+  // subtree; normal binds show zombie=0 / rootwalk=1 / rootchain=1.
+  {
+    const uint64_t s3ChildId = aChildDoc->mActorID;
+    bool s3InMap = GetAccessible(aParentID) != nullptr;
+    bool s3Zombie = !outerDoc->RemoteParent();
+    bool s3ChildUnderEmbedder = aChildDoc->RemoteParent() == outerDoc;
+    bool s3RootWalkReachesChild = false;
+    nsTArray<RemoteAccessible*> s3Queue;
+    for (const RefPtr<RemoteAccessible>& s3RootChild : mChildren) {
+      s3Queue.AppendElement(s3RootChild.get());
+    }
+    size_t s3Visited = 0;
+    while (!s3Queue.IsEmpty() && s3Visited++ < 100000) {
+      RemoteAccessible* s3Cur = s3Queue[s3Queue.Length() - 1]; s3Queue.RemoveLastElement();
+      if (s3Cur == outerDoc) {
+        s3RootWalkReachesChild = true;
+        break;
+      }
+      for (const RefPtr<RemoteAccessible>& s3Child : s3Cur->mChildren) {
+        s3Queue.AppendElement(s3Child.get());
+      }
+    }
+    uint32_t s3RootChainLen = 0;
+    bool s3RootChainReachesDoc = false;
+    for (RemoteAccessible* s3Cur = aChildDoc->RemoteParent(); s3Cur;
+         s3Cur = s3Cur->RemoteParent()) {
+      s3RootChainLen++;
+      if (s3Cur == this) {
+        s3RootChainReachesDoc = true;
+        break;
+      }
+    }
+    printf_stderr(
+        "S3PROBE bind child=%" PRIu64 " embedder=%" PRIu64
+        " in-map=%d zombie=%d child-under-embedder=%d"
+        " rootwalk-reaches-child=%d rootchain-reaches-doc=%d"
+        " rootchain-len=%u\n",
+        s3ChildId, aParentID, s3InMap ? 1 : 0, s3Zombie ? 1 : 0,
+        s3ChildUnderEmbedder ? 1 : 0, s3RootWalkReachesChild ? 1 : 0,
+        s3RootChainReachesDoc ? 1 : 0, s3RootChainLen);
+  }
+  // S3PROBE END.
+
   if (aCreating && !aChildDoc->IsPrintDoc()) {
     ProxyCreated(aChildDoc);
   }
