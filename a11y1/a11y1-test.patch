diff --git a/testing/mochitest/tests/Harness_sanity/test_a11y1_forge.html b/testing/mochitest/tests/Harness_sanity/test_a11y1_forge.html
new file mode 100644
index 00000000..b4741de5
--- /dev/null
+++ b/testing/mochitest/tests/Harness_sanity/test_a11y1_forge.html
@@ -0,0 +1,39 @@
+<!DOCTYPE HTML>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>A11Y-1 forged move/hide repro</title>
+  <script src="/tests/SimpleTest/SimpleTest.js"></script>
+  <link rel="stylesheet" type="text/css" href="/tests/SimpleTest/test.css">
+</head>
+<body>
+<script>
+SimpleTest.waitForExplicitFinish();
+SimpleTest.requestFlakyTimeout("deliberate waits for the a11y pipeline to flush");
+
+// A11Y-1 repro (plain mochitest: the forge is emitted by the test-only sender
+// patch in the CONTENT process, which requires a remote/ipcDoc accessible —
+// a plain content test provides exactly that; a chrome test would run in the
+// parent and ipcDoc would be null). The sender forges, for this element only:
+// AccessiblesWillMove([id]) followed by a Hide + Hide pair in one mutation
+// batch. With an unguarded build, the parent process SEGVs on the second hide
+// in DocAccessibleParent::ProcessHideEvent. With the guard probe
+// (a11y1-fix.patch), the parent rejects the hide via IPC_FAIL and survives.
+is(SpecialPowers.getIntPref("accessibility.force_disabled"), -1,
+   "a11y is force-enabled for this test");
+
+const el = document.createElement("button");
+el.id = "a11y1-forge";
+el.textContent = "A11Y1-FORGE";
+document.body.appendChild(el);
+
+setTimeout(() => {
+  el.remove();
+  setTimeout(() => {
+    ok(true, "parent process survived the forged hide sequence");
+    SimpleTest.finish();
+  }, 4000);
+}, 3000);
+</script>
+</body>
+</html>
